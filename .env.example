# Copie ce fichier en .env puis modifie les valeurs
# Genere un token solide avec : tr -dc 'a-f0-9' </dev/urandom | head -c 48
UPLOAD_TOKEN=change-moi

# Ton nom de domaine public, SANS https:// ni slash (ex: ipa.exemple.fr).
# - Les liens de telechargement de source.json l'utilisent quand on passe par ce domaine.
# - Si tu utilises Caddy (profil https), c'est aussi l'adresse pour laquelle il obtient le certificat.
# Pour changer de domaine plus tard : modifie cette ligne puis "docker compose up -d".
# Laisse vide pour un usage 100% local : les liens reprennent alors l'adresse utilisee (http://IP:8000).
DOMAIN=ipa.exemple.fr

# Acces local : 0.0.0.0 = joignable depuis ton reseau (http://IP-du-LXC:8000)
# Mets 127.0.0.1 pour reserver le port au conteneur lui-meme (ex: derriere Caddy ou un tunnel)
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8000

SOURCE_NAME=Ma source IPA
DEVELOPER_NAME=Nino
MAX_UPLOAD_MB=2048
