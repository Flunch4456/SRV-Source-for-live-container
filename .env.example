# Copie ce fichier en .env puis modifie les valeurs
# Genere un token solide avec : openssl rand -hex 24
UPLOAD_TOKEN=change-moi

# URL publique finale (SANS slash a la fin). Les liens de telechargement en dependent.
PUBLIC_URL=https://ipa.exemple.fr

SOURCE_NAME=Ma source IPA
DEVELOPER_NAME=Nino
MAX_UPLOAD_MB=2048
